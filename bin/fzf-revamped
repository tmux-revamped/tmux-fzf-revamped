#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

fzf_revamped_self="$0"
case "${fzf_revamped_self}" in
*/*) ;;
*) fzf_revamped_self="$(command -v -- "${fzf_revamped_self}")" ;;
esac
fzf_revamped_lib="$(cd "${fzf_revamped_self%/*}/../lib" && pwd)" || exit 1
for fzf_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(FZF_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${fzf_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${fzf_revamped_inherited}" ;;
  esac
done
REVAMPED_LIB="${fzf_revamped_lib}"

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/fzf.sh
. "${REVAMPED_LIB}/fzf.sh"
# shellcheck source=SCRIPTDIR/../lib/arrange.sh
. "${REVAMPED_LIB}/arrange.sh"
# shellcheck source=SCRIPTDIR/../lib/pickers.sh
. "${REVAMPED_LIB}/pickers.sh"

fzf_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=fzf-revamped REVAMPED_UI_VERSION="${FZF_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="every session, window and pane in fzf"
  if [ -n "${FZF_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${FZF_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=FZF_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

fzf_revamped_usage() {
  fzf_revamped_interface
  revamped_cli_usage_error "$1"
}

fzf_revamped_help() {
  revamped_cli_help_page <<'HELP'
fzf-revamped - switch, kill, rename or create sessions, windows and panes in fzf

usage:
  fzf-revamped apply                 bind the keys now
  fzf-revamped list                  print every binding apply would make
  fzf-revamped palette               run a tmux command from a short list
  fzf-revamped session|window|pane [switch|kill]
                                     switch to or kill the one picked
  fzf-revamped tree                  pick any session, window or pane
  fzf-revamped create                switch to a session, or create one
                                     named after what was typed
  fzf-revamped urls [open|copy]      open a URL on the screen, or copy it
                                     into a tmux buffer
  fzf-revamped cheatsheet            browse the key bindings and run one
  fzf-revamped process [SIGNAL]      send a signal to a process, TERM by
                                     default, after a confirmation
  fzf-revamped rename [session|window]
                                     rename the one picked
  fzf-revamped multi-kill [session|window|pane]
                                     kill several, after a confirmation
  fzf-revamped broadcast [TEXT]      type TEXT and Enter into every pane
                                     picked
  fzf-revamped zoxide                open a session at a zoxide folder
  fzf-revamped last                  switch to the last session
  fzf-revamped move-window [move|link]
                                     move or link a window to a session
  fzf-revamped arrange [join|break|swap|layout|resize]
                                     bring a pane into this window, move
                                     one into its own window, swap one with
                                     this pane, lay this window out, or
                                     move an edge of this pane; asks which
                                     when none is given
  fzf-revamped buffers [paste|delete]
                                     paste a tmux buffer into this pane, or
                                     delete it
  fzf-revamped projects              open a session at a folder from the
                                     projects file; a running one is marked
  fzf-revamped preview TARGET        print a pane, for the switch preview
  fzf-revamped doctor                check this machine
  fzf-revamped version               print the version
  fzf-revamped help                  print this page

options:
  --json           list prints one JSON object
  --theme NAME     the look: kodougu, catppuccin-mocha, catppuccin-latte,
                   dracula, nord, gruvbox, tokyo-night or mono
  --SETTING VALUE  any tmux option below, named with dashes, such as
                   --session-key s or --mru on

environment:
  FZF_REVAMPED_SETTING  any tmux option below in capitals, such as
                        FZF_REVAMPED_MRU
  FZF_REVAMPED_THEME    the look, when --theme is not given
  FZF_REVAMPED_ACCENT   a colour such as #CBA6F7 for the accent
  KODOUGU_THEME         the family look, when neither is given
  KODOUGU_ACCENT        the family accent, when the tool's is unset
  NO_COLOR              turn colour off

tmux options:
  @fzf_revamped_palette_key     key of the palette; off for none (M-f)
  @fzf_revamped_session_key     key of the session switcher (unbound)
  @fzf_revamped_window_key      key of the window switcher (unbound)
  @fzf_revamped_pane_key        key of the pane switcher (unbound)
  @fzf_revamped_kill_key        key of the session killer (unbound)
  @fzf_revamped_tree_key        key of the tree (unbound)
  @fzf_revamped_create_key      key of create or switch (unbound)
  @fzf_revamped_url_key         key of the URL opener (unbound)
  @fzf_revamped_cheatsheet_key  key of the cheatsheet (unbound)
  @fzf_revamped_process_key     key of the process signaller (unbound)
  @fzf_revamped_rename_key      key of the window renamer (unbound)
  @fzf_revamped_multikill_key   key of the session multi-kill (unbound)
  @fzf_revamped_broadcast_key   key of the broadcast prompt (unbound)
  @fzf_revamped_zoxide_key      key of the zoxide sessions (unbound)
  @fzf_revamped_last_key        key of the last session (unbound)
  @fzf_revamped_move_key        key of the window mover (unbound)
  @fzf_revamped_arrange_key     key of the pane arranger (unbound)
  @fzf_revamped_buffer_key      key of the buffer picker (unbound)
  @fzf_revamped_projects_key    key of the project sessions (unbound)
  @fzf_revamped_popup_width     popup width (60%)
  @fzf_revamped_popup_height    popup height (50%)
  @fzf_revamped_popup_border    rounded, single, double, heavy, simple,
                                padded or none, on tmux 3.4 (rounded)
  @fzf_revamped_preview         on shows the pane under the cursor (off)
  @fzf_revamped_mru             on orders sessions by last attach (off)
  @fzf_revamped_projects        the projects file
                                (~/.config/fzf-revamped/projects)
  @revamped_theme               the family look (kodougu)

notes:
  The entry point runs apply once when tmux loads the plugin, and every
  binding goes to tmux in one call. A key opens a popup, or a window before
  tmux 3.2, that runs one of the commands above. Every list line carries the
  target as a hidden first column, so a name with a space or a slash still
  resolves. A preview, mru or projects given as a tmux option is read when a
  picker runs; one given to apply on the command line or in the environment
  rides on the keys it binds. The broadcast prompt keeps its text in
  @fzf_revamped_broadcast_text until the pane picker reads it. The projects
  file holds one folder per line: a line with a * lists every folder it
  matches, ~ is the home folder, and a line that starts with # is skipped.

examples:
  fzf-revamped list
  fzf-revamped --session-key s apply
  fzf-revamped doctor
HELP
}

fzf_revamped_version() {
  fzf_revamped_tmux=$(tmux -V 2>/dev/null) || fzf_revamped_tmux=missing
  printf '%s %s\n' fzf-revamped "${FZF_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${fzf_revamped_tmux#tmux }"
}

fzf_revamped_doctor_optional() {
  if [ -n "$2" ]; then
    revamped_doctor_line "$1" ok "$2"
    return 0
  fi
  revamped_doctor_line "$1" warn "$3"
}

fzf_revamped_doctor_settings() {
  fzf_revamped_doctor_settings_rows=$(fzf_revamped_setting_rows)
  # shellcheck disable=SC2154
  revamped_doctor_settings "${FZF_REVAMPED_KINDS}" "${fzf_revamped_doctor_settings_rows}"
}

fzf_revamped_doctor() {
  revamped_doctor_tmux
  revamped_doctor_required fzf "brew install fzf, or apt install fzf"
  fzf_revamped_doctor_opener=$(fzf_revamped_opener)
  fzf_revamped_doctor_optional opener "${fzf_revamped_doctor_opener}" "urls open needs xdg-open or open"
  fzf_revamped_doctor_zoxide=$(command -v zoxide 2>/dev/null) || fzf_revamped_doctor_zoxide=""
  fzf_revamped_doctor_optional zoxide "${fzf_revamped_doctor_zoxide}" "the zoxide picker needs zoxide"
  fzf_revamped_plan
  fzf_revamped_doctor_projects=$(fzf_revamped_projects_file)
  [ -r "${fzf_revamped_doctor_projects}" ] || fzf_revamped_doctor_projects=""
  fzf_revamped_doctor_optional projects "${fzf_revamped_doctor_projects}" "the projects picker needs a file, one folder per line; see @fzf_revamped_projects"
  [ -z "${FZF_REVAMPED_TAKEN}" ] || revamped_doctor_line "prefix ${FZF_REVAMPED_TAKEN}" warn "already bound, so the palette has no key; set @fzf_revamped_palette_key"
  fzf_revamped_doctor_settings
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed grep tr sort cut ps
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

fzf_revamped_list() {
  fzf_revamped_plan
  if [ -n "${fzf_revamped_json}" ]; then
    fzf_revamped_json
    return 0
  fi
  fzf_revamped_lines
}

fzf_revamped_apply_command() {
  fzf_revamped_apply
  fzf_revamped_count=$(fzf_revamped_bindings)
  printf 'Applied. %s keys are bound.\n' "${fzf_revamped_count}"
}

fzf_revamped_menu() {
  revamped_cli_require_terminal
  fzf_revamped_choice=$(revamped_cli_menu "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${fzf_revamped_choice}" in
  "List the bindings") fzf_revamped_list ;;
  "Apply them now") fzf_revamped_apply_command ;;
  "Check this machine") fzf_revamped_doctor ;;
  *) fzf_revamped_help ;;
  esac
}

fzf_revamped_dispatch() {
  case "${1:-}" in
  doctor) fzf_revamped_doctor ;;
  version | --version | -V) fzf_revamped_version ;;
  help | --help | -h) fzf_revamped_help ;;
  list) fzf_revamped_list ;;
  "") fzf_revamped_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

fzf_revamped_known() {
  [ "$1" != --theme ] || return 0
  fzf_revamped_known_name=$(fzf_revamped_setting_name "$1")
  [ -n "${fzf_revamped_known_name}" ] || fzf_revamped_usage "unknown option '$1'"
}

fzf_revamped_set() {
  fzf_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "FZF_REVAMPED_${fzf_revamped_set_upper}=$2"
}

fzf_revamped_option() {
  fzf_revamped_option_name=$(fzf_revamped_setting_name "$1")
  [ -n "${fzf_revamped_option_name}" ] || fzf_revamped_usage "unknown option '$1'"
  fzf_revamped_set "${fzf_revamped_option_name}" "$2"
}

fzf_revamped_main() {
  fzf_revamped_theme="${FZF_REVAMPED_THEME:-}" fzf_revamped_json="" fzf_revamped_count=$# fzf_revamped_rest=0
  while [ "${fzf_revamped_count}" -gt 0 ]; do
    fzf_revamped_arg="$1"
    shift
    fzf_revamped_count=$((fzf_revamped_count - 1))
    case "${fzf_revamped_rest}:${fzf_revamped_arg}" in
    1:*) set -- "$@" "${fzf_revamped_arg}" ;;
    0:--) fzf_revamped_rest=1 ;;
    0:--json) fzf_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${fzf_revamped_arg}" ;;
    0:--theme=*) fzf_revamped_theme="${fzf_revamped_arg#--theme=}" ;;
    0:--*=*) fzf_revamped_option "${fzf_revamped_arg%%=*}" "${fzf_revamped_arg#*=}" ;;
    0:--*)
      fzf_revamped_known "${fzf_revamped_arg}"
      [ "${fzf_revamped_count}" -gt 0 ] || fzf_revamped_usage "option '${fzf_revamped_arg}' needs a value"
      if [ "${fzf_revamped_arg}" = --theme ]; then
        fzf_revamped_theme="$1"
      else
        fzf_revamped_option "${fzf_revamped_arg}" "$1"
      fi
      shift
      fzf_revamped_count=$((fzf_revamped_count - 1))
      ;;
    0:-?*) fzf_revamped_usage "unknown option '${fzf_revamped_arg}'" ;;
    *) set -- "$@" "${fzf_revamped_arg}" ;;
    esac
  done
  fzf_revamped_run "${fzf_revamped_theme}" "$@"
}

fzf_revamped_run() {
  fzf_revamped_run_theme="$1"
  shift
  [ -z "${fzf_revamped_json}" ] || [ "${1:-}" = list ] || fzf_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) fzf_revamped_apply ;;
  session | window | pane)
    fzf_revamped_load
    fzf_revamped_switcher "$1" "${2:-switch}"
    ;;
  tree | create | palette | cheatsheet | zoxide | last | projects)
    fzf_revamped_load
    "fzf_revamped_$1"
    ;;
  urls | process | rename | broadcast | preview)
    fzf_revamped_load
    "fzf_revamped_$1" "${2:-}"
    ;;
  multi-kill)
    fzf_revamped_load
    fzf_revamped_multi_kill "${2:-session}"
    ;;
  move-window) fzf_revamped_move_window "${2:-move}" ;;
  arrange) fzf_revamped_arrange "${2:-}" ;;
  buffers) fzf_revamped_buffers "${2:-paste}" ;;
  *)
    fzf_revamped_interface
    revamped_cli_start "${fzf_revamped_run_theme}"
    fzf_revamped_dispatch "$@"
    ;;
  esac
}

fzf_revamped_main "$@"
